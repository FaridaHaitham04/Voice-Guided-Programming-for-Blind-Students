# ── BlindCode backend environment ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# URL of the running Ollama server.
# Default when Ollama is started locally with no extra config:
OLLAMA_HOST=http://localhost:11434

# Which model the AI tutor uses for chat responses.
# Must be pulled first: ollama pull qwen2.5-coder:7b
TUTOR_MODEL=qwen2.5-coder:7b

# Comma-separated origins that may call this API from a browser.
# The Vite dev server is the default; adjust for staging/production.
ALLOWED_ORIGINS=http://localhost:5173
