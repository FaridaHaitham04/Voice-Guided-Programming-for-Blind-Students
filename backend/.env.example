# ── BlindCode backend environment ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# URL of the running Ollama server.
OLLAMA_HOST=http://localhost:11434

# AI Tutor LLM (pull first with: ollama pull qwen2.5-coder:1.5b)
TUTOR_MODEL=qwen2.5-coder:1.5b

# Tutor generation tuning for complete, calm spoken answers:
TUTOR_TEMPERATURE=0.6
TUTOR_MAX_TOKENS=512
OLLAMA_KEEP_ALIVE=30m
# Set OLLAMA_NUM_GPU=0 if your GPU hits a CUDA kernel image error:
# OLLAMA_NUM_GPU=0

# Whisper Speech-to-Text (faster-whisper):
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Piper Text-to-Speech (length_scale > 1.0 slows speech for clearer listening):
PIPER_MODEL_PATH=./voices/en_US-lessac-medium.onnx
PIPER_LENGTH_SCALE=1.28

# Comma-separated origins allowed to call this API from a browser.
ALLOWED_ORIGINS=http://localhost:5173
